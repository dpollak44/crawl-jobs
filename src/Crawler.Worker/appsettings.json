{
  "ConnectionStrings": {
    "Default": "Data Source=crawler.db"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "guest",
    "RetryDelayMs": 5000,
    "MaxAttempts": 3,
    "Prefetch": 8
  },
  "Crawl": {
    "DefaultMaxDepth": 2,
    "DefaultMaxPages": 200,
    "IncludeSubdomains": false,
    "FetchTimeoutSeconds": 10,
    "FetchRetries": 2,
    "MaxRedirects": 5,
    "MaxBodyBytes": 2097152
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
