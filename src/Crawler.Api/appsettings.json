{
  "ConnectionStrings": {
    "Default": "Data Source=crawler.db"
  },
  "Paging": {
    "DefaultPageSize": 50,
    "MaxPageSize": 200
  },
  "Import": {
    "MaxFileBytes": 10485760
  },
  "Payer": {
    "BaseUrl": "http://localhost:9999/"
  },
  "Resilience": {
    "Retry": {
      "MaxRetryAttempts": 3,
      "Delay": "00:00:01",
      "BackoffType": "Exponential",
      "UseJitter": true
    },
    "AttemptTimeout": {
      "Timeout": "00:00:10"
    },
    "TotalRequestTimeout": {
      "Timeout": "00:00:30"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
