{
  "ConnectionStrings": {
    "Default": "Data Source=crawler.db"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "guest",
    "RetryDelayMs": 5000,
    "MaxAttempts": 3
  },
  "Crawl": {
    "DefaultMaxDepth": 2,
    "DefaultMaxPages": 200
  },
  "Cors": {
    "Origins": ["http://localhost:3000", "http://localhost:5173"]
  },
  "Paging": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
